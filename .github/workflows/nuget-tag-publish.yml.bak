name: publish nuget

on:
  push:
    tags:
    - '*'

jobs:
  build:
    runs-on: windows-latest

    steps:
    - uses: actions/checkout@v5

    - name: Setup .NET
      uses: actions/setup-dotnet@v5
      with:
        dotnet-version: |
          10.0.x

    - name: Install dotnet tool
      run: dotnet tool install -g dotnetCampus.TagToVersion

    - name: Set tag to version
      run: dotnet TagToVersion -t ${{ github.ref }}

    - name: Build and pack
      run: |
        dotnet build --configuration release
        dotnet pack --configuration release --no-build

    - name: Push generated package to NuGet
      shell: pwsh
      run: |
        $packages = Get-ChildItem -Path .\artifacts\package\release -Filter *.nupkg -ErrorAction SilentlyContinue
        if (-not $packages) {
          Write-Host "No NuGet packages were generated. Skip publishing."
          exit 0
        }

        foreach ($package in $packages) {
          dotnet nuget push $package.FullName -s https://api.nuget.org/v3/index.json -k ${{ secrets.NugetKey }} --skip-duplicate
          dotnet nuget push $package.FullName -s https://nuget.pkg.github.com/${{ github.repository_owner }} --api-key ${{ secrets.GITHUB_TOKEN }} --timeout 3000 --skip-duplicate
        }
